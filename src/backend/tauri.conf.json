{
  "productName": "ThypingScripts",
  "version": "0.1.0",
  "identifier": "com.thypingscripts.app",
  "build": {
    "beforeDevCommand": "cd src/frontend && npm run dev",
    "beforeBuildCommand": "cd src/frontend && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "ThypingScripts",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {}
}
